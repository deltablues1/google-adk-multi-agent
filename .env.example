# ==========================================
# Google Workspace ADK Multi-Agent System
# ==========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ==========================================
# Environment
# ==========================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==========================================
# Monitoring & Logging
# ==========================================
USE_CLOUD_LOGGING=true
MONITORING_EVENT_BUFFER_SIZE=400

# ==========================================
# Google Cloud Project
# ==========================================
GOOGLE_CLOUD_PROJECT=your-project-id
# Authentication: use ADC (gcloud auth application-default login)
# Or set: GOOGLE_APPLICATION_CREDENTIALS=./service_account_key.json
GOOGLE_CLOUD_LOCATION=global
VERTEX_AI_LOCATION=us-west1

# ==========================================
# OAuth 2.0 Credentials
# ==========================================
# Get from: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth2callback

# Only for LOCAL development!
OAUTHLIB_INSECURE_TRANSPORT=1

# ==========================================
# Gemini API Configuration
# ==========================================
# OPTION 1: Vertex AI (recommended for production)
GOOGLE_GENAI_USE_VERTEXAI=true

# OPTION 2: Google AI API (fallback)
# GOOGLE_GENAI_USE_VERTEXAI=false
# Get your API key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-api-key

# Model names
# NOTE: these three are older than the code defaults (gemini-3.5-flash /
# gemini-3.1-pro-preview). Setting them here overrides the newer defaults, so
# raise them deliberately — the RAG specialists (socrates, christian_guide)
# still need their corpus verified against 3.x before PRO_MODEL moves.
FLASH_MODEL=gemini-2.5-flash
PRO_MODEL=gemini-2.5-pro
ORCHESTRATOR_MODEL=gemini-2.5-flash

# Model behind google_search_grounding. Kept separate from FLASH_MODEL so the
# search path can move forward without touching every Gemini agent; falls back
# to FLASH_MODEL, then to gemini-3.5-flash. Grounding needs the GLOBAL endpoint.
GROUNDING_MODEL=gemini-3.5-flash

# === LLM provider routing (experimental: Claude via LiteLLM) ===
# Default is Gemini. Set to "anthropic" to route agents through Claude
# (requires `pip install litellm` and ANTHROPIC_API_KEY below).
LLM_PROVIDER=gemini
# ANTHROPIC_API_KEY=sk-ant-...
# Gemini tier -> Claude tier mapping (used only when LLM_PROVIDER=anthropic).
# Sonnet 5: near-Opus quality at Sonnet price; adaptive thinking is on by
# default (the factory strips temperature — Sonnet 5 rejects sampling params).
CLAUDE_FLASH_MODEL=claude-sonnet-5
CLAUDE_PRO_MODEL=claude-sonnet-5
CLAUDE_LITE_MODEL=claude-sonnet-5
# Content workers (analyst, mailer, researcher, scribe, marketing, synthesizer,
# expense) default to CLAUDE_PRO_MODEL; glue/routing agents (orchestrator,
# planner, summarizer, secretary, tracker, rolodex, ...) use the tier map (cheap).
# Per-agent override wins over both (comma-separated agent=model):
# CLAUDE_AGENT_MODELS=researcher=claude-opus-5,synthesizer=claude-opus-5,scribe=claude-opus-5
# Research is where a weaker model shows: it has to triangulate sources that
# disagree and stay honest across 10+ tool calls, so the researcher is worth
# the tier. Voice lanes stay on the cheap tier — there latency is the cost.
# Anthropic prompt caching of the (large, static) agent instructions (default on):
CLAUDE_PROMPT_CACHE=true
# Retry Anthropic 429/5xx with exponential backoff (helps burst rate-limits):
CLAUDE_RETRY_ATTEMPTS=4
# Agents kept on Gemini regardless of provider (Vertex RAG, etc.).
# socrates and christian_guide are always pinned; add more comma-separated:
# CLAUDE_GEMINI_ONLY_AGENTS=scraper
# Note: the researcher's tools are plain async functions — the grounding call
# inside them still goes to Gemini whatever the agent's own model is — so it
# does not need to be pinned here.
# Per-agent token accounting (default on): set false to disable.
TOKEN_STATS_ENABLED=true

# ==========================================
# Session Configuration
# ==========================================
SESSION_STORAGE=memory
# Options: memory, database, firestore

# Persistent ADK sessions: persist agent conversation state to Firestore
# so agent context survives server restarts and session switches.
# Set to true in production; false (default) keeps in-memory only for local dev.
USE_PERSISTENT_ADK_SESSIONS=false

# Plan-Execute orchestration: for genuine multi-step requests, decompose into an
# ordered plan and run each step as an isolated agent call (deterministic chain),
# instead of relying on the Smart Orchestrator to chain tools in one LLM run.
# Single-step / special requests still fall back to the Smart Orchestrator.
# false (default) keeps the legacy single-run orchestration.
USE_PLAN_EXECUTE=false

# ==========================================
# Google Custom Search API
# ==========================================
# Fallback for Vertex AI Grounding when quota is exhausted
# Create Search Engine at: https://programmablesearchengine.google.com/
# Uses GOOGLE_API_KEY set above
GOOGLE_CUSTOM_SEARCH_CX=your-search-engine-cx

# ==========================================
# Optional: RAG Corpus IDs (for Philosophy & Company Knowledge Base)
# ==========================================
# PHILOSOPHY_CORPUS_ID=projects/YOUR_PROJECT/locations/us-west1/ragCorpora/YOUR_CORPUS_ID
# CHRISTIAN_CORPUS_ID=projects/YOUR_PROJECT/locations/us-west1/ragCorpora/YOUR_CORPUS_ID
# COMPANY_CORPUS_ID=projects/YOUR_PROJECT/locations/us-west1/ragCorpora/YOUR_CORPUS_ID

# ==========================================
# Optional: Cloud Storage for Generated Assets
# ==========================================
# GOOGLE_CLOUD_STORAGE_BUCKET=your-bucket-name

# ==========================================
# Optional: Telegram Bot Interface
# ==========================================
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# ==========================================
# Croatian Fiscalization (Fiskalizacija 2.0)
# ==========================================
# FINA DEMO Certificate for sandbox testing
# Get from FINA: https://www.fina.hr/
FINA_CERT_PATH=your-certificate.p12
FINA_CERT_PASSWORD=your-cert-password
FINA_SANDBOX=true

# Human-in-the-loop confirmation
ENABLE_HITL=true
AUTO_APPROVE_HITL=false

# HITL interface context — determines if blocking terminal input is allowed.
# Values: terminal (default, CLI), web, telegram, scheduler
# Set automatically by each entry point (run_web.py, run_scheduler.py).
# Only override manually for custom integrations.
# HITL_INTERFACE=terminal

# Firestore persistence for ledger and retry queue
USE_FIRESTORE=true

# ==========================================
# Web Dashboard Security
# ==========================================
# Optional bearer token to protect /api/* endpoints.
# If set, all API requests must include: Authorization: Bearer <token>
# Leave unset for local dev (no auth required).
# /api/media/ is intentionally not protected (browser img/video tags need it).
# API_TOKEN=your-random-secret-token-here

# ==========================================
# Peppol / eRačun AP Integration (Sprint C2.1)
# ==========================================
# REST endpoint of the Access Point (AP) for sending Peppol documents.
# Leave unset to run in stub mode (no actual send — safe for dev).
# PEPPOL_AP_ENDPOINT=https://ap.fina.hr/api/v1/send
#
# API key / Bearer token issued by your AP provider.
# PEPPOL_AP_API_KEY=your-ap-api-key
#
# Your company's Peppol sender ID in scheme:identifier format.
# HR OIB scheme = 0190. Example: 0190:47034854402
# Falls back to company_settings.peppol_participant_id if not set.
# PEPPOL_AP_SENDER_ID=0190:your-company-oib
#
# HMAC-SHA256 secret for webhook signature verification.
# AP should sign the webhook body with this secret and send the hex digest in
# X-Peppol-Signature header.  Leave unset to accept all webhooks (dev only).
# PEPPOL_AP_WEBHOOK_SECRET=your-webhook-secret

# ==========================================
# MQTT Smart Home (ESP32-IO)
# ==========================================
MQTT_BROKER=192.168.100.200
MQTT_PORT=1883
MQTT_USER=your-mqtt-username
MQTT_PASS=your-mqtt-password

# ==========================================
# Deployment Profile
# ==========================================
# Valid values (config/deployment_config.py): dev | web | rpi-home
#   dev      = local development, all features, no API token (default)
#   web      = web/server deployment, all features
#   rpi-home = smart home runtime — wake word + selected agents, no ERP
# Unknown values silently fall back to dev.
DEPLOYMENT_PROFILE=dev

# ==========================================
# OAuth Token Storage (optional)
# ==========================================
# Override default token path (~/.google_workspace_adk/tokens.json)
# OAUTH_TOKEN_STORAGE_PATH=/home/pi/.google_workspace_adk/tokens.json

# ==========================================
# Voice / Runtime Toggles (optional)
# ==========================================
# Direct-route wake-word requests to smart_home / christian_guide / socrates
# before orchestrator fallback. Enabled by default on rpi-home.
# VOICE_DIRECT_ROUTING=true
#
# Disable flaky Google ADK telemetry trace hooks that can crash on
# non-JSON-safe payloads during RAG/tool calls. Enabled by default on rpi-home.
# DISABLE_ADK_TELEMETRY=true
#
# Fail-fast OAuth precheck before boot. Default true on full profile,
# false on rpi-home.
# REQUIRE_OAUTH_HEALTHCHECK=false
#
# Allow the web process to start embedded APScheduler jobs.
# Default true on full profile, false on rpi-home.
# ENABLE_WEB_SCHEDULER=false
#
# Voice defaults for /api/tts and /api/live.
# TTS_MODEL=gemini-2.5-flash-tts
# TTS_VOICE_NAME=Charon
# TTS_LANGUAGE_CODE=hr-HR
# TTS_USE_VERTEXAI=false
# VOICE_ASSISTANT_GENDER=male
# STT_MODEL=gemini-2.5-flash
# STT_LANGUAGE=Croatian
# STT_USE_VERTEXAI=true
#
# --- Optional OpenAI voice engine (additive; default is Gemini/Cloud) -------
# Flip STT/TTS to OpenAI independently. Requires OPENAI_API_KEY.
# OPENAI_API_KEY=sk-...
# STT_ENGINE=openai
# OPENAI_STT_MODEL=gpt-4o-transcribe
# OPENAI_STT_LANGUAGE=hr
# TTS_ENGINE=openai
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# Delivery steering for gpt-4o-mini-tts. A Croatian default is built in;
# override here, or set to "none" to send no instructions at all.
# OPENAI_TTS_INSTRUCTIONS=Govori prirodno i poslovno, na hrvatskom.
# Cloud TTS voice served when OpenAI TTS fails (empty string disables):
# TTS_FALLBACK_VOICE=hr-HR-Chirp3-HD-Charon
#
# --- Gemini 3.5 Transcribe (STT_ENGINE=gemini_transcribe) ---
# Google's dedicated ASR model. Croatian is supported as hr-HR, it takes the
# audio inline (no Files API round trip) and lists at ~$0.005/min against
# Chirp's $0.016. Two things to know before switching:
#   * Developer API only — the model is NOT on Vertex (404, checked 2026-09-02),
#     so GEMINI_API_KEY must belong to an AI Studio project with credit. Without
#     credit every call returns 429 and this engine falls back to Chirp.
#   * Detection is never used: the language is always pinned, because both
#     engines rejected before this one mistook Croatian for another Slavic one.
# STT_ENGINE=gemini_transcribe
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# Comma-separated BCP-47 codes; defaults to STT_LANGUAGE_CODE (hr-HR).
# GEMINI_TRANSCRIBE_LANGUAGES=hr-HR
# "smart" cleans fillers and false starts, "verbatim" keeps every word.
# Unset lets the model decide.
# GEMINI_TRANSCRIBE_MODE=smart
# Up to 1000 terms the model should expect — room names, device names, people.
# GEMINI_TRANSCRIBE_VOCABULARY=Jarvis,kupaona,bojler,Luxtech
# Engine used when the one above fails (chirp by default, "none" to fail loudly):
# STT_FALLBACK_ENGINE=chirp
#
# --- Slow answers on a phone ---
# Home Assistant Assist ends when the phone's screen sleeps and the pipeline
# run dies with it: measured 2026-09-03, a 53 s turn was spoken back in full
# while a 3 min 25 s research task finished with nobody left listening. Past
# this many seconds the turn says the work continues and the finished answer is
# pushed to the phone instead. 0 disables the whole thing (and restores the old
# behaviour of answering into a window that may be gone).
# VOICE_DEFER_AFTER_SECONDS=25
# VOICE_DEFER_ACK_TEXT=Ovo će potrajati. Nastavljam raditi i poslat ću ti odgovor na mobitel čim bude gotov.
# Where the late answer goes — an HA notify service, "domain.service":
# HA_NOTIFY_SERVICE=notify.mobile_app_mobitel
# "notify" pushes the text (default); "speak" makes the companion app read it
# out loud instead, which is louder than most late answers deserve.
# LATE_ANSWER_MODE=notify
# LATE_ANSWER_MAX_CHARS=2000
#
# --- xAI Grok Voice probe (scripts/xai_voice_probe.py only, not wired into engines yet) ---
# Croatian is not in xAI's officially listed languages; probe before considering STT_ENGINE/TTS_ENGINE=xai.
# XAI_API_KEY=xai-...
# XAI_TTS_VOICE=eve
# Wake-word loop: stream TTS playback (start speaking on the first chunk):
# WAKEWORD_TTS_STREAMING=true
# Capture tuning (scripts/run_wakeword.py):
# WAKEWORD_RECORD_SECONDS_MAX=8.0
# WAKEWORD_SILENCE_SECONDS=1.2
# WAKEWORD_MIN_SPEECH_SECONDS=0.6
# WAKEWORD_ENERGY_THRESHOLD=900
#
# Voice weather lane (Open-Meteo, bez API ključa). Default grad kad pitanje
# nema izgovorenu lokaciju ("kakvo je vrijeme sutra"):
# VOICE_WEATHER_DEFAULT_LOCATION=Zagreb
#
# Voice turn-taking defaults.
# Set false to require a new wake word after every answer.
# WAKEWORD_THRESHOLD=0.4
# VOICE_FOLLOW_UP_MODE=false
# VOICE_FOLLOW_UP_MAX_TURNS=4
# VOICE_WAKE_PROMPT_TEXT=Slušam.
# VOICE_FOLLOW_UP_PROMPT_TEXT=Treba li još nešto?
# Wake-word microphone switch, exposed to Home Assistant over MQTT discovery.
# Off means the capture device is closed, not that detections are discarded.
# WAKEWORD_LISTEN_ON_START=false
# WAKEWORD_AUTO_OFF_MINUTES=30
# WAKEWORD_IDLE_POLL_SECONDS=0.5
# VOICE_LISTEN_ON_TEXT=Reci?
# Hard cap on one agent turn; on expiry the run is cancelled and the message
# below is spoken. Multi-step orchestrations legitimately take minutes.
# VOICE_AGENT_TIMEOUT_SECONDS=300
# VOICE_AGENT_TIMEOUT_MESSAGE=Oprosti, zadatak traje predugo pa sam ga prekinuo.
# Spoken cue before long orchestrator runs (empty string disables):
# VOICE_WORKING_ACK_TEXT=Radim na tome. Ovo može potrajati minutu ili dvije.
# === Home Assistant TV/media tools (smart_home agent; opt-in) ===
# HA_URL=http://192.168.100.200:8123
# HA_TOKEN=<long-lived access token>
# TV_MEDIA_PLAYER_ENTITY=media_player.tv
# TV_REMOTE_ENTITY=remote.tv
# TV_MAC=d0:65:b3:07:97:bc
# TV_WAKE_RETRIES=4

# Anti-noise wake tuning: Silero VAD gate (0 disables; 0.4-0.6 sensible) and
# consecutive 80ms frames the score must stay above WAKEWORD_THRESHOLD
# (1 = off; 2 filters single-frame noise spikes, adds ~80ms wake latency).
# WAKEWORD_VAD_THRESHOLD=0.5
# WAKEWORD_MIN_CONSECUTIVE_FRAMES=2
# VOICE_TTS_TIMEOUT_SECONDS=35
# VOICE_TTS_STREAM_MIN_PLAY_BYTES=4800
# VOICE_TTS_STREAM_MAX_CHARS=320
#
# Research fallbacks
# GOOGLE_CUSTOM_SEARCH_CX=your-search-engine-cx
# FIRECRAWL_API_KEY=your-firecrawl-api-key
