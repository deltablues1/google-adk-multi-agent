# SECURITY: Certificates & Keys (NEVER commit)
# ============================================================================
*.p12
*.pfx
*.pem
*.cer
*.crt
*.key
client_cert.*
client_key.*
*_ca_bundle.*

# ============================================================================
# SECURITY: Google Credentials (NEVER commit)
# ============================================================================
*.json
!package.json
!dashboards/*.json
!data/**/*.json
!schemas/**/*.json
!firestore.indexes.json

# Specific credential files (double safety)
oauth_client_credentials.json
service_account_key.json
credentials.json
service-account.json

# OAuth tokens
tokens.json
.google_workspace_adk/

