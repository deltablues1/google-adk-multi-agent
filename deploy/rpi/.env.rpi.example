# ==========================================
# RPi 5 Smart Home .env Template
# ==========================================
# Copy to ~/google_claude/.env and fill in values

# Deployment profile
DEPLOYMENT_PROFILE=rpi-home
ENABLE_WAKE_WORD=true

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
VERTEX_AI_LOCATION=us-west1
GOOGLE_CLOUD_LOCATION=global

# Gemini API (required for STT, TTS, Live voice)
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_GENAI_USE_VERTEXAI=true

# OAuth 2.0
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth2callback
# OAUTH_TOKEN_STORAGE_PATH=/home/pi/.google_workspace_adk/tokens.json

# MQTT Smart Home
MQTT_BROKER=192.168.100.200
MQTT_PORT=1883
MQTT_USER=your-mqtt-user
MQTT_PASS=your-mqtt-pass

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Firestore
USE_FIRESTORE=true

# HITL
ENABLE_HITL=true
AUTO_APPROVE_HITL=false

# Session
SESSION_STORAGE=memory
USE_PERSISTENT_ADK_SESSIONS=false

# Web dashboard security (optional)
# API_TOKEN=your-random-token

# Wake word config (optional overrides)
# WAKEWORD_MODEL=hey_jarvis
# WAKEWORD_THRESHOLD=0.5
# WAKEWORD_API_URL=http://localhost:8000
