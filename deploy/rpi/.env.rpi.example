DEPLOYMENT_PROFILE=rpi-home
ERP_ENABLED=true
# Firestore tenant for ERP voice tools (skladistar); must match the
# company_id on products/customers docs (production tenant: luxtech).
ERP_COMPANY_ID=luxtech
TELEGRAM_ENABLED=true
WAKE_WORD_ENABLED=true
VOICE_MODE_DEFAULT=agent
API_TOKEN_REQUIRED=true

API_TOKEN=replace-me
GEMINI_API_KEY=replace-me
GEMINI_VOICE_NAME=Charon
VOICE_ASSISTANT_NAME=Jarvis
VOICE_ASSISTANT_STYLE=smiren, profesionalan, kratak, diskretno butlerovski
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=replace-me
GOOGLE_APPLICATION_CREDENTIALS=/opt/google-clause/secrets/service_account_key.json
GOOGLE_CLOUD_LOCATION=global
VERTEX_AI_LOCATION=us-west1
GOOGLE_OAUTH_CLIENT_ID=replace-me
GOOGLE_OAUTH_CLIENT_SECRET=replace-me
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth2callback
USE_CLOUD_LOGGING=false

TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me
TELEGRAM_AUTHORIZED_CHAT_IDS=

OAUTH_TOKEN_STORAGE_PATH=/opt/google-clause/state/oauth/tokens.json
USE_PERSISTENT_ADK_SESSIONS=true

MQTT_BROKER=192.168.1.10
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
HA_MQTT_DISCOVERY_ENABLED=true
HA_MQTT_DISCOVERY_PREFIX=homeassistant
HA_MQTT_STATE_PREFIX=google_clause/rpi_voice
HA_MQTT_DEVICE_ID=google_clause_rpi_voice
HA_MQTT_DEVICE_NAME=Jarvis

WAKEWORD_API_BASE_URL=http://127.0.0.1:8000
WAKEWORD_USER_ID=rpi-voice
# Engine: openwakeword (default, free, no key) or porcupine
WAKEWORD_ENGINE=openwakeword
# openWakeWord: bundled pretrained model + probability threshold (0..1)
WAKEWORD_MODEL=hey_jarvis
WAKEWORD_THRESHOLD=0.5
# Porcupine only (WAKEWORD_ENGINE=porcupine):
# PICOVOICE_ACCESS_KEY=replace-me
WAKEWORD_KEYWORDS=jarvis
WAKEWORD_SENSITIVITY=0.65
WAKEWORD_RECORD_SECONDS_MAX=8
WAKEWORD_SILENCE_SECONDS=1.2
WAKEWORD_MIN_SPEECH_SECONDS=0.6
WAKEWORD_ENERGY_THRESHOLD=900
WAKEWORD_INPUT_DEVICE=
WAKEWORD_OUTPUT_DEVICE=
WAKEWORD_TTS_ENABLED=true
# --- Microphone switch (Home Assistant) ------------------------------------
# The Pi mic is opt-in. Home Assistant gets a "Slušanje" switch (entity
# switch.jarvis_slusanje) that opens and closes the capture device: while it is
# off the microphone is not held at all, so nothing can reach STT or the LLM.
# Default off, because an always-listening room mic once turned music from a
# nearby speaker into two days of unnoticed agent turns.
WAKEWORD_LISTEN_ON_START=false
# Turns listening back off after this many idle minutes -- the net for a switch
# flipped on and forgotten. 0 disables the timer.
WAKEWORD_AUTO_OFF_MINUTES=30
# Spoken as the mic opens; also wakes the wm8960 amplifier, which powers down
# when idle and otherwise swallows the first word of the next answer.
VOICE_LISTEN_ON_TEXT=Reci?
# Follow-up mode: after Jarvis asks a question ("Potvrđuješ?"), the mic
# reopens without requiring the wake word again — needed for stock writes.
VOICE_FOLLOW_UP_MODE=true
VOICE_FOLLOW_UP_MAX_TURNS=4
LIVE_INPUT_SAMPLE_RATE=16000
LIVE_OUTPUT_SAMPLE_RATE=24000
LIVE_BLOCK_SIZE=8192
LIVE_ENERGY_THRESHOLD=650
LIVE_IDLE_TIMEOUT_SECONDS=8
LIVE_MIN_SESSION_SECONDS=2
LIVE_MAX_SESSION_SECONDS=90
LIVE_CONTROL_SILENCE_SECONDS=1.0
LIVE_CONTROL_MIN_SPEECH_SECONDS=0.5
LIVE_CONTROL_MAX_RECORD_SECONDS=4.0
TELEGRAM_AUDIO_MAX_DURATION_SECONDS=120

# Voice runtime flags (rpi-home profile defaults shown)
VOICE_DIRECT_ROUTING=true
DISABLE_ADK_TELEMETRY=true
ENABLE_WEB_SCHEDULER=false
USE_CLOUD_LOGGING=true
