# ==========================================
# RPi 5 Smart Home .env Template
# ==========================================
# Copy to ~/google_claude/.env and fill in values

# Deployment profile
DEPLOYMENT_PROFILE=rpi-home
ENABLE_WAKE_WORD=true
VOICE_DIRECT_ROUTING=true
DISABLE_ADK_TELEMETRY=true
REQUIRE_OAUTH_HEALTHCHECK=false
ENABLE_WEB_SCHEDULER=false

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
VERTEX_AI_LOCATION=us-west1
USE_CLOUD_LOGGING=true
MONITORING_EVENT_BUFFER_SIZE=400

# Gemini API (required for TTS fallback / Live voice)
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_GENAI_USE_VERTEXAI=true

# OAuth 2.0
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth2callback
# OAUTH_TOKEN_STORAGE_PATH=/home/pi/.google_workspace_adk/tokens.json

# MQTT Smart Home
MQTT_BROKER=192.168.100.200
MQTT_PORT=1883
MQTT_USER=your-mqtt-user
MQTT_PASS=your-mqtt-pass

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Firestore
USE_FIRESTORE=true

# HITL
ENABLE_HITL=true
AUTO_APPROVE_HITL=false

# Session
SESSION_STORAGE=memory
USE_PERSISTENT_ADK_SESSIONS=false

# Web dashboard security (optional)
# API_TOKEN=your-random-token

# Wake word / voice runtime
# WAKEWORD_MODEL=hey_jarvis
WAKEWORD_THRESHOLD=0.4
WAKEWORD_API_URL=http://localhost:8000
# WAKEWORD_LISTENING_CUE=true
WAKEWORD_INPUT_DEVICE=0
WAKEWORD_OUTPUT_DEVICE=0
WAKEWORD_USER_ID=rpi-voice

VOICE_LOCAL_SMART_HOME_FAST_PATH=true
VOICE_DEBUG_AUDIO_METRICS=true
VOICE_MAX_RECORD_TIME=30
VOICE_SILENCE_TIMEOUT=5
VOICE_PRE_SPEECH_TIMEOUT=8
VOICE_SPEECH_RMS_THRESHOLD=900
VOICE_SILENCE_RMS_THRESHOLD=170

VOICE_FOLLOW_UP_MODE=true
VOICE_FOLLOW_UP_MAX_TURNS=4
VOICE_WAKE_PROMPT_TEXT="Slusam."
VOICE_FOLLOW_UP_PROMPT_TEXT="Treba li jos nesto?"
VOICE_SUPPRESS_LISTENING_CUE_WHEN_PROMPT=true
VOICE_NO_SPEECH_CUE=true
VOICE_AGENT_TIMEOUT_SECONDS=90
VOICE_TTS_TIMEOUT_SECONDS=35
VOICE_TTS_STREAM_MIN_PLAY_BYTES=4800
VOICE_TTS_STREAM_MAX_CHARS=320
VOICE_SMART_HOME_RESPONSE_MODE=none

# Optional RAG corpora
# CHRISTIAN_CORPUS_ID=projects/YOUR_PROJECT/locations/us-west1/ragCorpora/YOUR_CORPUS_ID

# TTS / STT
TTS_MODEL=gemini-2.5-flash-tts
TTS_VOICE_NAME=Charon
TTS_LANGUAGE_CODE=hr-HR
TTS_USE_VERTEXAI=false
VOICE_ASSISTANT_GENDER=male

STT_MODEL=gemini-2.5-flash
STT_LANGUAGE=Croatian
STT_USE_VERTEXAI=true

# Research fallbacks
GOOGLE_CUSTOM_SEARCH_CX=your-search-engine-cx
FIRECRAWL_API_KEY=your-firecrawl-api-key
