[Unit]
Description=Google ADK Telegram Bot
After=network-online.target adk-web.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/google_claude
EnvironmentFile=/home/pi/google_claude/.env
Environment=DEPLOYMENT_PROFILE=rpi-home
Environment=HITL_INTERFACE=telegram
ExecStart=/home/pi/google_claude/.venv/bin/python scripts/telegram_bot.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
