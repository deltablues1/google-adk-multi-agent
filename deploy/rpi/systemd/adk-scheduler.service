[Unit]
Description=Google Clause Scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/google-clause
EnvironmentFile=/opt/google-clause/deploy/rpi/.env.rpi
ExecStart=/opt/google-clause/.venv/bin/python run_scheduler.py --no-cli
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
