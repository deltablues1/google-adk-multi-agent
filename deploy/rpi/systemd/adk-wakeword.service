[Unit]
Description=Google Clause Wakeword Interface
After=network-online.target adk-web.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/google-clause
EnvironmentFile=/opt/google-clause/deploy/rpi/.env.rpi
ExecStart=/opt/google-clause/.venv/bin/python scripts/run_wakeword.py --wakeword
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
