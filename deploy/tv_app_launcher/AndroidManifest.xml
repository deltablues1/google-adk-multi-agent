<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="hr.jarvis.launcher"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="30" />

    <!-- Android TV must not reject the app for lacking touchscreen support. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="true" />

    <!-- Android 11+ hides other packages unless they are queried explicitly.
         Launching any installed app is the entire point of this app. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application
        android:label="Jarvis Launcher"
        android:allowBackup="false"
        android:banner="@android:drawable/ic_menu_send"
        android:icon="@android:drawable/ic_menu_send">

        <activity
            android:name=".LaunchActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault"
            android:excludeFromRecents="true"
            android:noHistory="true">

            <!-- The whole reason this app exists: a URI the TV will resolve. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jarvis" />
            </intent-filter>

            <!-- Visible in the TV's app list so it can be opened and checked. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
